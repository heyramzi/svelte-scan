{
  "name": "@heyramzi/svelte-scan",
  "version": "0.4.0",
  "description": "SvelteKit dev tool: health monitoring, element inspector, AI browser testing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyramzi/svelte-scan.git"
  },
  "files": [
    "src",
    "bin",
    "index.ts",
    "stub.ts",
    "vite-plugin.ts",
    "logo.svg"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./stub.ts"
    },
    "./vite-plugin": {
      "types": "./vite-plugin.ts",
      "development": "./vite-plugin.ts",
      "import": "./vite-plugin.ts",
      "default": "./stub.ts"
    },
    "./stub": "./stub.ts",
    "./expect": {
      "types": "./src/expect/index.ts",
      "development": "./src/expect/index.ts",
      "import": "./src/expect/index.ts",
      "default": "./stub.ts"
    }
  },
  "bin": {
    "svelte-scan": "./bin/svelte-scan.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "release": "changeset publish"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@lucide/svelte": "^1.8.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "agent-browser": "^0.24.0",
    "jsdom": "^29.0.2",
    "tsx": "^4.21.0",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
