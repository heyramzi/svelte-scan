{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "#src/*": ["./src/*"],
      "#bin/*": ["./bin/*"],
      "#root/*": ["./*"]
    }
  },
  "include": ["src"]
}
