{
  "name": "@heyramzi/svelte-scan",
  "version": "0.6.4",
  "description": "SvelteKit dev tool: health monitoring, element inspector, AI browser testing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyramzi/svelte-scan.git"
  },
  "bin": {
    "svelte-scan": "./bin/svelte-scan.mjs"
  },
  "files": [
    "src",
    "bin",
    "index.ts",
    "stub.ts",
    "vite-plugin.ts",
    "logo.svg"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./stub.ts"
    },
    "./vite-plugin": {
      "types": "./vite-plugin.ts",
      "development": "./vite-plugin.ts",
      "import": "./vite-plugin.ts",
      "default": "./stub.ts"
    },
    "./stub": "./stub.ts",
    "./expect": {
      "types": "./src/expect/index.ts",
      "svelte": "./src/expect/index.ts",
      "development": "./src/expect/index.ts",
      "import": "./src/expect/index.ts",
      "default": "./stub.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "vp test run",
    "release": "changeset publish",
    "fallow": "fallow",
    "fallow:dead-code": "fallow dead-code",
    "fallow:audit": "fallow audit",
    "fallow:health": "fallow health",
    "fallow:dupes": "fallow dupes",
    "lint:comment-length": "heyramzi-comment-length",
    "lint:comment-length:update": "heyramzi-comment-length --update",
    "lint": "vp fmt --check . && vp lint -c .oxlintrc.json . && pnpm lint:comment-length",
    "lint:fix": "vp fmt . && vp lint -c .oxlintrc.json --fix .",
    "format": "vp fmt",
    "format:check": "vp fmt --check"
  },
  "dependencies": {
    "@lucide/svelte": "^1.17.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@heyramzi/lint": "^3.2.1",
    "fallow": "^3.18.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "packageManager": "pnpm@11.0.6"
}
